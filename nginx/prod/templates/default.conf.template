# Üretim sunucu blokları. ${SERVER_NAME} konteyner açılışında ortam değişkeninden doldurulur
# (nginx imajının /etc/nginx/templates mekanizması); nginx değişkenleri ($host vb.) dokunulmaz.

# Bilinmeyen Host başlığı: yanıt vermeden bağlantıyı kapat (yalnızca SERVER_NAME kabul edilir).
server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name _;
    return 444;
}

# HTTP -> HTTPS
server {
    listen 80;
    server_name ${SERVER_NAME};

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SERVER_NAME};

    root /usr/share/nginx/html;

    # --- SPA (derlenmiş frontend) --------------------------------------------------------------
    # index.html her açılışta yeniden doğrulanır; yeni sürüm hemen görünür.
    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    # Vite çıktısı: dosya adları içerik özetli, süresiz önbelleğe alınabilir.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Diğer her yol: varsa dosya (favicon vb.), yoksa SPA yönlendirmesi için index.html.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }

    # --- API -----------------------------------------------------------------------------------
    location /api/ {
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/proxy-http.conf;
        proxy_pass http://backend;
    }

    location = /api/v1/auth/login/ {
        include /etc/nginx/snippets/security-headers.conf;
        limit_req zone=login burst=10 nodelay;
        include /etc/nginx/snippets/proxy-http.conf;
        proxy_pass http://backend;
    }

    # Swagger UI betik ve stilleri cdn.jsdelivr.net'ten gelir; yalnızca iç ağ / VPN.
    location /api/docs/ {
        include /etc/nginx/snippets/security-headers-docs.conf;
        if ($internal_client = 0) {
            return 403;
        }
        include /etc/nginx/snippets/proxy-http.conf;
        proxy_pass http://backend;
    }

    location /api/schema/ {
        include /etc/nginx/snippets/security-headers.conf;
        if ($internal_client = 0) {
            return 403;
        }
        include /etc/nginx/snippets/proxy-http.conf;
        proxy_pass http://backend;
    }

    # Django yönetim paneli: yalnızca iç ağ / VPN.
    location /admin/ {
        include /etc/nginx/snippets/security-headers.conf;
        if ($internal_client = 0) {
            return 403;
        }
        include /etc/nginx/snippets/proxy-http.conf;
        proxy_pass http://backend;
    }

    # Anlık bildirimler (Django Channels)
    location /ws/ {
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_pass http://backend;
    }

    # collectstatic çıktısı (yönetim paneli ve Swagger dışı Django statikleri); `static` volume'ü.
    location /static/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=604800" always;
        alias /var/www/static/;
        try_files $uri =404;
    }
}
