# Bu dosyayı .env olarak kopyalayın: cp .env.example .env
# .env depoya girmez; gerçek şifreleri yalnızca orada tutun.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=degistir-beni-uzun-ve-rastgele-bir-anahtar
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

POSTGRES_DB=deterjan
POSTGRES_USER=deterjan
POSTGRES_PASSWORD=deterjan
DATABASE_URL=postgres://deterjan:deterjan@db:5432/deterjan

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# Demo kullanıcı şifresi: create_demo_users komutu her rol için (kullanıcı adı = rol kodu)
# bu şifreyle kullanıcı oluşturur. Yalnızca geliştirme ortamında (DJANGO_DEBUG=True) çalışır.
DEMO_USER_PASSWORD=Demo.12345

# Giriş denemesi sınırı (IP başına; API ve yönetim paneli ortak) ve sayaçların tutulduğu önbellek
LOGIN_RATE_LIMIT=10/minute
CACHE_URL=redis://redis:6379/2
