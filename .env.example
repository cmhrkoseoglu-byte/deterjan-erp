# Bu dosyayı .env olarak kopyalayın: cp .env.example .env
# .env depoya girmez; gerçek şifreleri yalnızca orada tutun.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=degistir-beni-uzun-ve-rastgele-bir-anahtar
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

POSTGRES_DB=deterjan
POSTGRES_USER=deterjan
POSTGRES_PASSWORD=deterjan
DATABASE_URL=postgres://deterjan:deterjan@db:5432/deterjan

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# Demo kullanıcı şifresi: create_demo_users komutu her rol için (kullanıcı adı = rol kodu)
# bu şifreyle kullanıcı oluşturur. Yalnızca geliştirme ortamında (DJANGO_DEBUG=True) çalışır.
DEMO_USER_PASSWORD=Demo.12345

# Giriş denemesi sınırı (IP başına; API ve yönetim paneli ortak) ve sayaçların tutulduğu önbellek
LOGIN_RATE_LIMIT=10/minute
CACHE_URL=redis://redis:6379/2

# Firma bilgileri (irsaliye ve analiz sertifikası başlığında)
COMPANY_NAME=Örnek Deterjan San. ve Tic. A.Ş.
COMPANY_ADDRESS=Organize Sanayi Bölgesi 1. Cadde No: 1, Kocaeli
COMPANY_TAX_OFFICE=Gebze
COMPANY_TAX_NO=1234567890

# Ekler (dosya/fotoğraf): en büyük boyut (bayt) ve depolama klasörü
# ATTACHMENT_MAX_BYTES=20971520
# MEDIA_ROOT=/app/media
# Etiket yazıcısı (TCP 9100) bağlantı zaman aşımı (saniye)
# PRINTER_TIMEOUT_SECONDS=5

# E-posta (satın alma siparişini tedarikçiye gönderme). Boşsa e-postalar yalnızca konsola yazılır.
# EMAIL_URL=smtp+tls://kullanici:sifre@smtp.ornek.com:587
# DEFAULT_FROM_EMAIL=satinalma@ornek.com
